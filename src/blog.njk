---
layout: base.njk
title: Blog
description: All posts.
---
<h1>Blog</h1>
<ul class="post-list">
{%- for post in collections.posts | reverse -%}
  <li>
    <a href="{{ post.url | url }}">{{ post.data.title }}</a>
    <span class="muted"> — {{ post.date | readableDate }}</span>
    {% if post.data.description %}<br /><span class="muted">{{ post.data.description }}</span>{% endif %}
  </li>
{%- endfor -%}
</ul>
